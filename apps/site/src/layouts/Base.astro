---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Jeuchre is a card game that you can think of as the anti-Euchre." } =
  Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-default.png", Astro.site);

const nav = [
  { href: "/", label: "Home" },
  { href: "/rules", label: "Rules" },
  { href: "/blog", label: "Blog" },
  { href: "/foundation", label: "Foundation" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <header>
      <div class="shell bar">
        <a class="wordmark" href="/">
          <span class="pip" aria-hidden="true">♠</span> Jeuchre
        </a>
        <nav aria-label="Main">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main" class="shell">
      <slot />
    </main>
    <footer>
      <div class="shell">
        <p>
          A card game from the (informal) Jeuchre Foundation. Rules and content
          <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>; code
          <a href="https://github.com/osaaru/jeuchre.org/blob/main/LICENSE">MIT</a> —
          <a href="https://github.com/osaaru/jeuchre.org">built in the open on GitHub</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .shell {
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--page-pad);
  }

  header {
    border-bottom: var(--border);
    background: var(--color-surface);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-3);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-ink);
    text-decoration: none;
  }

  .pip {
    color: var(--color-red);
  }

  nav {
    display: flex;
    gap: var(--space-3);
  }

  nav a {
    color: var(--color-ink-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  nav a:hover {
    color: var(--color-red);
  }

  main {
    padding-block: var(--space-5) var(--space-6);
  }

  footer {
    border-top: var(--border);
    background: var(--color-surface);
    padding-block: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
</style>
